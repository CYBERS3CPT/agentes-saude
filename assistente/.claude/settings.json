{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./saida/**)",
      "Bash(python3 ferramentas/pagina.py:*)",
      "Bash(python ferramentas/pagina.py:*)",
      "Bash(open saida/:*)",
      "Bash(xdg-open saida/:*)",
      "Bash(mkdir -p saida/:*)",
      "Bash(ls:*)",
      "Bash(python3 ferramentas/urgencias.py:*)",
      "Bash(python ferramentas/urgencias.py:*)",
      "mcp__browser__browser_navigate",
      "mcp__browser__browser_snapshot",
      "mcp__browser__browser_click",
      "mcp__browser__browser_wait_for",
      "mcp__browser__browser_find",
      "mcp__browser__browser_select_option",
      "mcp__browser__browser_navigate_back",
      "mcp__browser__browser_take_screenshot",
      "mcp__browser__browser_close",
      "Bash(python3 ferramentas/mascarar.py:*)",
      "Bash(python ferramentas/mascarar.py:*)",
      "Agent(atacante)",
      "Bash(python3 ferramentas/dados_sns.py:*)",
      "Bash(python3 ferramentas/verificar.py:*)",
      "Bash(python3 saida/relatorio/analise/*)",
      "Bash(python3 ferramentas/procurar.py:*)",
      "Bash(python ferramentas/procurar.py:*)",
      "Bash(python3 ferramentas/pontuar.py:*)",
      "Bash(python ferramentas/pontuar.py:*)",
      "Agent(avaliador)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(mail:*)",
      "Bash(sendmail:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "WebFetch",
      "WebSearch",
      "Edit(./dados/**)",
      "Edit(./.claude/**)",
      "mcp__browser__browser_type",
      "mcp__browser__browser_fill_form",
      "mcp__browser__browser_press_key",
      "mcp__browser__browser_file_upload",
      "mcp__browser__browser_drag",
      "mcp__browser__browser_drop",
      "Bash(python3 ferramentas/notificar.py:*)",
      "Bash(python ferramentas/notificar.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(~/.ssh/**)",
      "mcp__browser__browser_evaluate",
      "mcp__browser__browser_run_code_unsafe"
    ]
  },
  "enabledMcpjsonServers": [
    "browser"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/diario.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
